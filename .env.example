# Copy to .env (or set in Replit Secrets) and fill in real values.

# Required
SESSION_SECRET=change-me-to-a-long-random-string
BASE_URL=http://localhost:3000

# Email (Gmail SMTP — uses an App Password, not the account password).
# GMAIL_USER/GMAIL_APP_PASSWORD are preferred; SMTP_USER/SMTP_PASS still work.
# If neither pair is set, invite/reset emails print to the server console and
# reset links also appear on the hab_admin Shops dashboard.
GMAIL_USER=heath.blake3@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
SMTP_FROM="HAB Academy <heath.blake3@gmail.com>"

# Heath's super-admin account — auto-seeded on boot with a login-ready password.
# Change ADMIN_INITIAL_PASSWORD before first deploy if you don't want the default.
ADMIN_EMAIL=heath@healthyautobusiness.com
ADMIN_NAME=Heath Blake
ADMIN_INITIAL_PASSWORD=HabAdmin2026!

# Optional
PORT=3000
NODE_ENV=development

# Optional: where SQLite files live (default: ./data). Useful if the repo dir is on a network mount.
# DATA_DIR=/absolute/path/to/data

# WP-ACADEMY-2: platform sync bridge. When set, shop-created and member-joined
# events POST to {PLATFORM_SYNC_URL}/api/integrations/academy/events with the
# X-HAB-SYNC-SECRET header. Unset or unreachable: events queue in sync_queue
# and retry on boot + hourly. Signups never block on this.
# PLATFORM_SYNC_URL=https://platform.example.com
# PLATFORM_SYNC_SECRET=change-me
