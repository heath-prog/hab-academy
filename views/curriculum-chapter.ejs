<%- include('partials/header', { title: ch.title }) %>

<div class="chapter-top">
  <a class="crumb" href="/curriculum">← Curriculum Library</a>
  <% if (ch.moduleKey) { %><span class="module-key inline"><%= ch.moduleKey %></span><% } %>
</div>

<% if (typeof notice !== 'undefined' && notice === 'check') { %>
<div class="alert info">
  Section recorded. Complete the comprehension check to earn your points.
  <a href="/curriculum/<%= ch.slug %>/check"><strong>Take the check now</strong></a>.
</div>
<% } %>

<% if (typeof check !== 'undefined' && check && !check.exempt) { %>
<div class="card" style="border-left: 4px solid var(--gold); padding: 12px 16px; margin-bottom: 14px;">
  <% if (check.passed) { %>
    <strong>Comprehension check passed.</strong>
    <span class="muted">This module's points are unlocked (10 per section).</span>
    <a href="/curriculum/<%= ch.slug %>/check" style="margin-left: 6px;">Retake for practice</a>
  <% } else { %>
    <strong>Comprehension check: not passed yet.</strong>
    <span class="muted">Sections you mark complete are recorded, but the points wait until you pass the check (<%= check.passPct %>% or better). Retakes allowed.</span>
    <a class="btn small" href="/curriculum/<%= ch.slug %>/check" style="margin-left: 8px;">Take the Check</a>
  <% } %>
</div>
<% } %>

<% if (ch.moduleKey && ch.sections.length) { %>
<div class="section-nav">
  <div class="section-nav-title">In this module — mark each section complete as you master it:</div>
  <ol>
    <% ch.sections.forEach(s => { %>
      <li class="<%= doneSlugs.has(s.slug) ? 'done' : '' %>">
        <a href="#s-<%= s.slug %>"><%= doneSlugs.has(s.slug) ? '✓ ' : '' %><%= s.title %></a>
      </li>
    <% }) %>
  </ol>
</div>
<% } %>

<%# WP-IP-LOCKDOWN: hab-nocopy marks reading surfaces (user-select off,
    context menu suppressed, copy returns the license notice). Forms and
    buttons outside these articles behave normally. %>
<article class="curric hab-nocopy">
  <%- ch.intro %>
</article>
<% if (protect) { %><div class="hab-license-line"><%= licenseLine %></div><% } %>

<% ch.sections.forEach(s => { %>
  <div class="curric-section" id="s-<%= s.slug %>">
    <article class="curric hab-nocopy">
      <%- s.html %>
    </article>
    <% if (ch.moduleKey) { %>
      <form method="post" action="/curriculum/<%= ch.slug %>/sections/<%= s.slug %>/toggle" class="complete-bar <%= doneSlugs.has(s.slug) ? 'is-done' : '' %>">
        <% if (doneSlugs.has(s.slug)) { %>
          <% if (typeof check !== 'undefined' && check && !check.exempt && !check.passed) { %>
            <span class="complete-msg">✓ Section complete · pass the check to earn the points</span>
          <% } else { %>
            <span class="complete-msg">✓ Section complete — +10 pts</span>
          <% } %>
          <button type="submit" class="btn ghost small">Undo</button>
        <% } else { %>
          <span class="complete-msg">Finished this section?</span>
          <% if (typeof check !== 'undefined' && check && !check.exempt && !check.passed) { %>
            <button type="submit" class="btn small">Mark complete</button>
          <% } else { %>
            <button type="submit" class="btn small">Mark complete (+10 pts)</button>
          <% } %>
        <% } %>
      </form>
    <% } %>
    <% if (protect) { %><div class="hab-license-line"><%= licenseLine %></div><% } %>
  </div>
<% }) %>

<div class="chapter-pager">
  <% if (prev) { %><a class="btn ghost" href="/curriculum/<%= prev.slug %>">← <%= prev.title %></a><% } else { %><span></span><% } %>
  <% if (next) { %><a class="btn" href="/curriculum/<%= next.slug %>"><%= next.title %> →</a><% } %>
</div>

<% if (user.role !== 'hab_admin') { %><script src="/hb.js" data-k="<%= ch.slug %>" defer></script><% } %>

<%- include('partials/footer') %>
