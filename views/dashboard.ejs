<%- include('partials/header', { title: 'Dashboard' }) %>

<div class="eyebrow">DASHBOARD</div>
<h1>Welcome, <%= user.name || user.email.split('@')[0] %>.</h1>
<p class="lead">
  <% if (user.role === 'hab_admin') { %>
    HAB admin view — you see every shop.
  <% } else if (user.role === 'owner' || user.role === 'coach') { %>
    <%= user.role === 'owner' ? 'Owner' : 'Coach' %> access — full curriculum + coaching infrastructure for <strong><%= user.shopName || 'your shop' %></strong>.
  <% } else { %>
    Advisor access — your training home base at <strong><%= user.shopName || 'your shop' %></strong>.
  <% } %>
</p>

<% if (typeof message !== 'undefined' && message) { %><div class="alert success"><%= message %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>

<%# WP-ACADEMY-2: weekday nudge when the previous business day's numbers are missing. %>
<% if (typeof scorecard !== 'undefined' && scorecard) { %>
  <% if (user.role === 'advisor' && scorecard.myMissing) { %>
    <div class="alert info">
      <strong>Your scorecard for <%= scorecard.myMissing %> is missing.</strong>
      Owning your numbers daily is a coaching tactic; champions log the scoreboard before the first call.
      <a href="/scorecard"><strong>Log it now</strong></a>.
    </div>
  <% } %>
  <% if (['coach','owner'].includes(user.role) && scorecard.shopMissing) { %>
    <div class="alert info">
      <strong>The shop scorecard for <%= scorecard.shopMissing %> is missing.</strong>
      Owning your numbers daily is a coaching tactic; the day is not closed until the numbers are down.
      <a href="/scorecard"><strong>Log it now</strong></a>.
    </div>
  <% } %>
<% } %>

<% if (typeof ownerPanel !== 'undefined' && ownerPanel) { %>
<div class="card" style="border-left: 4px solid var(--gold); margin-bottom: 18px;">
  <h2 style="margin-top: 0;">Your Shop, Your Keys</h2>
  <div class="owner-panel-grid">
    <div>
      <div class="stat-label">Team join code</div>
      <div class="join-code-chip"><%= ownerPanel.joinCode || 'not set' %></div>
      <div class="stat-sub">Give this to advisors, technicians and coaches. They sign up at <strong>/signup</strong> and join your shop with it.</div>
    </div>
    <div>
      <div class="stat-label">Agreement</div>
      <% if (ownerPanel.agreement) { %>
        <div style="font-size: 15px; font-weight: 700; color: var(--navy); margin: 4px 0;">
          <%= ownerPanel.tierLabel %> · <%= ownerPanel.agreement.term_months %> months
        </div>
        <div class="stat-sub">
          <% if (ownerPanel.access.state === 'active') { %>
            Active through <%= ownerPanel.agreement.end_date %> (<%= ownerPanel.access.daysRemaining %> day<%= ownerPanel.access.daysRemaining === 1 ? '' : 's' %> remaining)
          <% } else if (ownerPanel.access.state === 'demo') { %>
            Demo shop, enforcement exempt
          <% } else { %>
            <span style="color: var(--red); font-weight: 700;">Ended <%= ownerPanel.agreement.end_date %></span>
          <% } %>
          · <a href="/agreements/<%= ownerPanel.agreement.id %>" target="_blank" rel="noopener">View signed agreement</a>
          <% if (ownerPanel.agreement.safe_html) { %>
            · <a href="/agreements/<%= ownerPanel.agreement.id %>/safe" target="_blank" rel="noopener">View SAFE</a>
          <% } %>
        </div>
      <% } else { %>
        <div class="stat-sub">No agreement on record. Contact HAB.</div>
      <% } %>
    </div>
  </div>

  <% if (ownerPanel.pendingMembers.length) { %>
    <h3 style="margin-top: 18px;">Pending team requests</h3>
    <table class="tbl" style="margin-bottom: 4px;">
      <thead><tr><th>Name</th><th>Email</th><th>Requested Role</th><th>Requested</th><th></th></tr></thead>
      <tbody>
        <% ownerPanel.pendingMembers.forEach(pm => { %>
          <tr>
            <td><strong><%= pm.name %></strong></td>
            <td><%= pm.email %></td>
            <td><span class="role-pill"><%= pm.role.toUpperCase() %></span></td>
            <td><span class="muted"><%= pm.created_at.replace('T', ' ').slice(0, 16) %></span></td>
            <td>
              <div class="row-actions">
                <form method="post" action="/team/pending/<%= pm.id %>/approve"><button type="submit" class="btn small">Approve</button></form>
                <form method="post" action="/team/pending/<%= pm.id %>/deny"><button type="submit" class="danger">Deny</button></form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<% } %>

<div class="stat-row">
  <div class="stat-card">
    <div class="stat-label">Training progress</div>
    <div class="stat-big"><%= me.pctComplete %>%</div>
    <div class="pbar"><div class="pbar-fill" style="width:<%= me.pctComplete %>%"></div></div>
    <div class="stat-sub"><%= me.sectionsCompleted %> of <%= me.sectionsTotal %> sections</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Points</div>
    <div class="stat-big gold"><%= me.points %></div>
    <div class="stat-sub">10 / section · 5+ / check-in</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Take-Five streak</div>
    <div class="stat-big"><%= me.streak %><span class="stat-unit"> day<%= me.streak === 1 ? '' : 's' %></span></div>
    <% if (me.checkedInToday) { %>
      <div class="stat-sub checked">✓ Checked in today</div>
    <% } else { %>
      <form method="post" action="/checkin" class="checkin-form">
        <input type="text" name="note" maxlength="280" placeholder="Today's five-minute focus…">
        <button type="submit" class="btn small">Take-Five check-in</button>
      </form>
    <% } %>
  </div>
  <div class="stat-card">
    <div class="stat-label">Mastery level</div>
    <div class="stat-big"><span class="mastery-badge lvl-<%= me.masteryLevel %>"><%= me.masteryName %></span></div>
    <div class="stat-sub">Level <%= me.masteryLevel %> of 5 — awarded by your coach</div>
  </div>
</div>

<%# WP-ACADEMY-2: 7/30-day scorecard trends on the dashboard. %>
<% if (typeof scorecard !== 'undefined' && scorecard) { %>
<div class="stat-row">
  <% if (scorecard.my.count || user.role === 'advisor') { %>
  <div class="stat-card">
    <div class="stat-label">My 7-Day ARO</div>
    <div class="stat-big"><%= scorecard.my.trends[7].aro == null ? 'n/a' : '$' + scorecard.my.trends[7].aro.toLocaleString('en-US', {minimumFractionDigits: 2}) %></div>
    <div class="stat-sub">30-day: <%= scorecard.my.trends[30].aro == null ? 'n/a' : '$' + scorecard.my.trends[30].aro.toLocaleString('en-US', {minimumFractionDigits: 2}) %> · <a href="/scorecard">Scorecard</a></div>
  </div>
  <% } %>
  <% if (scorecard.shop) { %>
  <div class="stat-card">
    <div class="stat-label">Shop 7-Day ARO</div>
    <div class="stat-big"><%= scorecard.shop.trends[7].aro == null ? 'n/a' : '$' + scorecard.shop.trends[7].aro.toLocaleString('en-US', {minimumFractionDigits: 2}) %></div>
    <div class="stat-sub">30-day: <%= scorecard.shop.trends[30].aro == null ? 'n/a' : '$' + scorecard.shop.trends[30].aro.toLocaleString('en-US', {minimumFractionDigits: 2}) %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Shop 7-Day GP%</div>
    <div class="stat-big gold"><%= scorecard.shop.trends[7].gpPct == null ? 'n/a' : scorecard.shop.trends[7].gpPct.toFixed(1) + '%' %></div>
    <div class="stat-sub">30-day: <%= scorecard.shop.trends[30].gpPct == null ? 'n/a' : scorecard.shop.trends[30].gpPct.toFixed(1) + '%' %> · <a href="/scorecard">Shop scorecard</a></div>
  </div>
  <% } %>
</div>
<% } %>

<div class="cta-row">
  <a class="btn" href="/curriculum">Open the Curriculum</a>
  <a class="btn ghost" href="/library">Book Library</a>
  <a class="btn ghost" href="/leaderboard">Shop Leaderboard</a>
  <% if (['coach','owner','hab_admin'].includes(user.role)) { %>
    <a class="btn ghost" href="/team">Team Progress</a>
  <% } %>
</div>

<% if (advisorFiles.length) { %>
<div class="tier-section">
  <h2>Reference Downloads</h2>
  <div class="file-grid">
    <% advisorFiles.forEach(f => { %>
      <a class="file-card" href="<%= f.url %>" target="_blank" rel="noopener">
        <div class="icon"><%= f.icon %></div>
        <div class="meta">
          <div class="name"><%= f.prettyName %></div>
          <div class="sub"><%= f.ext.replace('.', '').toUpperCase() %> · <%= Math.round(f.size / 1024) %> KB</div>
        </div>
      </a>
    <% }) %>
  </div>
</div>
<% } %>

<% if (managerFiles.length) { %>
<div class="tier-section">
  <h2>Coaching &amp; Manager Resources</h2>
  <div class="file-grid">
    <% managerFiles.forEach(f => { %>
      <a class="file-card" href="<%= f.url %>" target="_blank" rel="noopener">
        <div class="icon"><%= f.icon %></div>
        <div class="meta">
          <div class="name"><%= f.prettyName %></div>
          <div class="sub"><%= f.ext.replace('.', '').toUpperCase() %> · <%= Math.round(f.size / 1024) %> KB</div>
        </div>
      </a>
    <% }) %>
  </div>
</div>
<% } %>

<%- include('partials/footer') %>
