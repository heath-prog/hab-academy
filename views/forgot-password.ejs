<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Forgot Password · HAB Academy</title>
<link rel="stylesheet" href="/style.css">
</head>
<body class="auth-wrap">
<div class="auth-card">
  <div class="brand-stack">
    <div class="shield">HAB</div>
    <div class="name">HAB Academy</div>
    <div class="sub">FORGOT PASSWORD</div>
  </div>

  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <% if (message) { %><div class="alert info"><%= message %></div><% } %>

  <% if (sent) { %>
    <div class="alert success">
      If that email has an HAB Academy account, a password reset link has been created.
      Check your inbox — or, if email isn't set up yet, ask your HAB administrator for the link.
      The link works once and expires in 1 hour.
    </div>
    <p style="font-size: 14px; text-align: center;"><a href="/login">Back to sign in</a></p>
  <% } else { %>
    <p style="font-size: 14px;">Enter your email and we'll create a single-use password reset link for you.</p>
    <form method="post" action="/forgot-password" class="stack">
      <div>
        <label for="email">Email</label>
        <input type="email" name="email" id="email" required autocomplete="email" autofocus>
      </div>
      <button type="submit" class="primary">Send Reset Link</button>
    </form>
    <p style="font-size: 13px; text-align: center; margin-top: 14px;"><a href="/login">Back to sign in</a></p>
  <% } %>

  <div class="tagline">Do what's Right · Do what's Fair · Do Your Best.</div>
</div>
</body>
</html>
